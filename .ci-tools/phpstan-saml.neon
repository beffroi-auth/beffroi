# PHPStan at level max, with no baseline, ever: every finding is fixed in the code or refused in the review.
#
# An analysis of its own, apart from .ci-tools/phpstan.neon, which excludes this package, as the SAML packages have:
# section 8 of src/saml/spec/saml.md bans what the identity provider's other packages may call (Reflection,
# unserialize()), so the bans are a rule of beffroi/saml and not of the others. They hold in src/ and in tests/ alike.
# The three rules of tests/saml/PhpStan hold what bindings.md section 6.8 asks of this package, and, copied from
# saml2-model (model.md section 8), the DOM, the parsers other than the one of xml-security and the weak generators;
# ekino/phpstan-banned-code holds the statements it knows (echo, eval, exit, print, backticks) and the defaults of its
# function list, as in the three packages below this one. What else model.md section 8 bans is the model's: this
# package signs and issues its certificate with openssl_* (Bridge\Pki) and calls the validators of the model, whose
# method is validate(). A loose comparison and base64_decode() without its strict flag are phpstan-strict-rules'.
#
# The extensions come from the phpqa image (/tools/.composer/vendor-bin/phpstan), which is where %rootDir% points;
# PHPUnit's classes are scanned from the image's PHPUnit install.
parameters:
	level: max
	# A result cache of its own, beside those of the other analyses, so that none drops another's.
	tmpDir: %currentWorkingDirectory%/.ci-tools/cache/phpstan-saml
	scanDirectories:
		- %rootDir%/../../../../phpunit/vendor
	# The directory of the package, whose PHP is under src/ only: src/saml/src does not exist before the first class of
	# the package, and a path PHPStan cannot find is an error.
	paths:
		- %currentWorkingDirectory%/src/saml
		- %currentWorkingDirectory%/tests/saml
	# The fixture of the rules is code written to be refused, analysed on its own by .ci-tools/phpstan-saml-rules.neon;
	# the interoperability scripts run in the image of SimpleSAMLphp, against a library that is not a dependency here.
	excludePaths:
		- %currentWorkingDirectory%/tests/saml/PhpStan/Fixture/*
		- %currentWorkingDirectory%/tests/saml/Interop/*
	checkUninitializedProperties: true
	treatPhpDocTypesAsCertain: false
	# The statements and the functions of ekino/phpstan-banned-code, its defaults, as saml2-model has them (section 8).
	banned_code:
		non_ignorable: true
		use_from_tests: true
		nodes:
			-
				type: Stmt_Echo
				functions: null
			-
				type: Expr_Eval
				functions: null
			-
				type: Expr_Exit
				functions: null
			-
				type: Expr_Print
				functions: null
			-
				type: Expr_ShellExec
				functions: null
			-
				type: Expr_FuncCall
				functions:
					# the defaults of the extension
					- dd
					- debug_backtrace
					- dump
					- exec
					- passthru
					- phpinfo
					- print_r
					- proc_open
					- shell_exec
					- system
					- var_dump
	# The classes and constants never used (section 8, model.md section 8, core.md section 8 for the DOM), for
	# BannedNamesRule: XML reaches the package through saml2-model and saml2-bindings, which load it with the one
	# Loader of xml-security, and through nothing else (I-2, I-4).
	bannedNames:
		- DOMDocument
		- DOMXPath
		- DOMImplementation
		- Dom\XPath
		- SimpleXMLElement
		- XMLReader
		- XMLWriter
		- LIBXML_NOENT
		- LIBXML_DTDLOAD
		- LIBXML_DTDATTR
		- LIBXML_DTDVALID
		- LIBXML_XINCLUDE
		- LIBXML_PARSEHUGE
		- LIBXML_NOBLANKS
		- LIBXML_NOCDATA
		# The proof Enc asks for before it opens AES-CBC, and the result of a verification (section 8, enc.md E-15): the
		# package neither implements the one nor builds the other, the one proof being saml2-model's, built from the
		# Verified that Dsig's Verifier gives
		- Beffroi\Xml\Enc\CoveringSignatureInterface
		- Beffroi\Xml\Dsig\Verified
	# The functions never called (section 8): unserialize() builds an object of any class, one of
	# Beffroi\Saml2\Bindings\Internal\ among them, without its constructor (finding 3 of the security review of
	# saml2-bindings); session_decode() is the same unserializer, fed the bytes of a session.
	bannedFunctions:
		- unserialize
		# a name the rules read where it is written, given another under which it passes unread (section 8)
		- class_alias
		- session_decode
		# model.md section 8, core.md section 8: no entity loader, no second parser (I-2, I-4)
		- libxml_set_external_entity_loader
		- libxml_disable_entity_loader
		- simplexml_load_string
		- simplexml_load_file
		- simplexml_import_dom
		- xml_parser_create
		- xml_parser_create_ns
		# model.md section 8: random_bytes() is the randomness; the other generators of the Mersenne Twister are banned
		# with them
		- rand
		- mt_rand
		- srand
		- mt_srand
		- uniqid
		- lcg_value
		- shuffle
		- str_shuffle
		- array_rand
	# The methods never called, whatever the receiver (section 8). validateAuthenticatedByBinding(): the binding's
	# authentication is the word of saml2-bindings only (B-5, bindings.md section 6.8). __unserialize(): the other half
	# of unserialize(). unserialize(): the same unserializer, under the method of the Serializable half of ArrayObject,
	# ArrayIterator, SplObjectStorage and SplDoublyLinkedList, banned on any receiver as the function is (D-1 of the
	# security review of sub-spike 9c).
	bannedMethods:
		- validateAuthenticatedByBinding
		# the one method that takes the proof of a covering signature, which only the model's reader calls (section 8,
		# enc.md E-15): a proof forged around the names reaches nothing
		- decryptCovered
		- __unserialize
		- unserialize
		# core.md section 8, I-4: the loaders of the DOM of PHP 8.4, a second parser; xml-security's Core loads
		- createFromString
		- createFromFile
	# The methods of Closure never called (section 8): a closure bound to the scope of Internal\Reception builds a
	# Reception that pairs the message of one input with the signature of another (bindings.md sections 6.8 and 12).
	closureMethods:
		- bind
		- bindTo
		- call
	# Reflection never used (section 8), for the same reason: ReflectionProperty::setValue(),
	# ReflectionClass::newInstanceWithoutConstructor(), a lazy ghost. The roots of the API, each banned with what extends
	# it: ReflectionObject and ReflectionEnum with ReflectionClass, ReflectionMethod and ReflectionFunction with
	# ReflectionFunctionAbstract, the enum cases with ReflectionClassConstant, the three kinds of type with
	# ReflectionType. ReflectionException is not among them: catching it reaches nothing.
	reflectionClasses:
		- Reflection
		- ReflectionAttribute
		- ReflectionClass
		- ReflectionClassConstant
		- ReflectionConstant
		- ReflectionExtension
		- ReflectionFiber
		- ReflectionFunctionAbstract
		- ReflectionGenerator
		- ReflectionParameter
		- ReflectionProperty
		- ReflectionReference
		- ReflectionType
		- ReflectionZendExtension

parametersSchema:
	bannedNames: listOf(string())
	bannedFunctions: listOf(string())
	bannedMethods: listOf(string())
	closureMethods: listOf(string())
	reflectionClasses: listOf(string())

services:
	-
		class: Beffroi\Saml\Tests\PhpStan\BannedNamesRule
		arguments:
			names: %bannedNames%
		tags:
			- phpstan.rules.rule
	-
		class: Beffroi\Saml\Tests\PhpStan\BannedCallsRule
		arguments:
			functions: %bannedFunctions%
			methods: %bannedMethods%
			closureMethods: %closureMethods%
			reflection: %reflectionClasses%
		tags:
			- phpstan.rules.rule
	# a first-class callable of a banned call is that call (BannedCallablesRule, issue #693)
	-
		class: Beffroi\Saml\Tests\PhpStan\BannedCallablesRule
		arguments:
			nodeType: PHPStan\Node\FunctionCallableNode
		tags:
			- phpstan.rules.rule
	-
		class: Beffroi\Saml\Tests\PhpStan\BannedCallablesRule
		arguments:
			nodeType: PHPStan\Node\MethodCallableNode
		tags:
			- phpstan.rules.rule
	-
		class: Beffroi\Saml\Tests\PhpStan\BannedCallablesRule
		arguments:
			nodeType: PHPStan\Node\StaticMethodCallableNode
		tags:
			- phpstan.rules.rule

includes:
	- %rootDir%/conf/bleedingEdge.neon
	- %rootDir%/../../ekino/phpstan-banned-code/extension.neon
	- %rootDir%/../phpstan-deprecation-rules/rules.neon
	- %rootDir%/../phpstan-phpunit/extension.neon
	- %rootDir%/../phpstan-phpunit/rules.neon
	- %rootDir%/../phpstan-strict-rules/rules.neon
