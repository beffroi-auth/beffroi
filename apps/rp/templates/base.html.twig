<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}rp{% endblock %}</title>
        <style>
            body { font: 16px/1.5 system-ui, sans-serif; max-width: 48rem; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
            header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #d0d7de; padding-bottom: .75rem; margin-bottom: 1.5rem; }
            a.button { display: inline-block; padding: .4rem .9rem; border-radius: 6px; background: #1f6feb; color: #fff; text-decoration: none; }
            a.button.secondary { background: #6e7781; }
            table { border-collapse: collapse; width: 100%; }
            th, td { text-align: left; padding: .35rem .5rem; border-bottom: 1px solid #d0d7de; vertical-align: top; }
            th { width: 12rem; font-weight: 600; }
            code, pre { font-family: ui-monospace, monospace; font-size: .875rem; }
            pre { background: #f6f8fa; padding: 1rem; border-radius: 6px; overflow-x: auto; }
            .error { background: #ffebe9; border: 1px solid #ff8182; padding: .75rem 1rem; border-radius: 6px; }
        </style>
    </head>
    <body>
        <header>
            <strong><a href="{{ path('app_home') }}">rp</a></strong>
            <nav>
                {% if app.user %}
                    <a href="{{ path('app_profile') }}">{{ app.user.userIdentifier }}</a>
                    <a class="button secondary" href="{{ path('_logout_main') }}">Log out</a>
                {% else %}
                    <a class="button" href="{{ path('_oidc_login_start_main') }}">Log in with the OP</a>
                {% endif %}
            </nav>
        </header>
        {% block body %}{% endblock %}
    </body>
</html>
