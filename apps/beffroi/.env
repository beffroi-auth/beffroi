# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# A variable that carries a secret, APP_SECRET, DATABASE_URL, BEFFROI_KMS_DSN, BEFFROI_KMS_DSN_SECOND,
# BEFFROI_MESSENGER_DSN, BEFFROI_DATA_KEY_SECRETS, BEFFROI_MAIL_DSN, BEFFROI_SMS_DSN and GEOIP_LICENSE_KEY, and
# BEFFROI_MIGRATIONS_DATABASE_URL, which the entrypoint of the image reads, may name the path of a file in its place,
# in the same name ending in _FILE, where Swarm and Compose mount a secret: the content of the file is the value,
# without the line breaks that end it. A deployment that sets both is refused; the values below are no setting, and a
# file replaces them.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://op.localhost
DEFAULT_LOCALE=en
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://beffroi:beffroi@127.0.0.1:5432/beffroi?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> beffroi ###
# The issuer every token names and every client compares byte for byte (no trailing slash).
BEFFROI_ISSUER=https://op.localhost
# Where a client that presents a certificate reaches the endpoints (RFC 8705 §5, architecture §6): the
# origin of the host whose TLS listener asks for one, announced in "mtls_endpoint_aliases". Empty here:
# "composer dump-env prod" compiles this file into the image, and a deployment that names no host then
# serves no mutual TLS, neither tls_client_auth, nor self_signed_tls_client_auth, nor a token bound to a
# certificate, where a host of the development stack would send its clients to a name that answers nowhere.
# A deployment that serves such a host names its origin, the host of the issuer when its listener sets
# SSL_CLIENT_CERT there itself, which the site of SERVER_NAME never does; "castor provision" writes the one
# of the development stack, the MTLS_SERVER_NAME of compose.yaml, into .env.local.
BEFFROI_MTLS_ORIGIN=
# The certificate authorities whose client certificates tls_client_auth accepts (RFC 8705 §2.1, §7.4), a JSON list
# of PEM certificates, each the authority that signs them itself: the listener hands PHP the leaf alone and judges
# nothing, so the provider validates it against these, at the moment of the request. None here: tls_client_auth is
# then neither announced nor registered, and self_signed_tls_client_auth with the tokens bound to a certificate
# follow BEFFROI_MTLS_ORIGIN alone.
BEFFROI_MTLS_CERTIFICATE_AUTHORITIES='[]'
# The slug of the tenant, the stable name its identifier is derived from: renaming it is creating another tenant,
# with other keys and other rows, so a deployment names it once.
BEFFROI_TENANT_SLUG=default
# The KMS that seals the signing keys and the key of that KMS they are sealed under. The DSN is read by the
# "op" client of config/packages/key_management.yaml, which is the client "beffroi.keys.kms" names. Empty here
# on purpose: nothing is sealed nor signed under a key everybody has. "castor provision --kms <backend>"
# writes them into .env.local, and the DSN is the only thing that changes between two backends, the code and
# the envelope are the same (docs/11-architecture.md §3.3); {tenant} in the key id names one master key per
# tenant. An envelope sealed by one backend does not open with another: switching is a rotation.
#   sodium, a key inline in the environment, the development default ("castor provision"):
#     BEFFROI_KMS_DSN="sodium://?keys[signing]=<32 bytes, base64url>"      BEFFROI_KMS_KEY_ID="signing"
#   file, the same sodium key read from a file of its own, mode 0600, outside the web root and outside the
#   sealed keys ("castor provision --kms file" writes var/kms/beffroi-<slug>.key in the container): the
#   self-hosted default when there is no KMS, worth a dump of the storage, not a compromise of the host:
#     BEFFROI_KMS_DSN="sodium+dir:///app/var/kms?ext=.key"                 BEFFROI_KMS_KEY_ID="beffroi-{tenant}"
#   HashiCorp Vault Transit ("castor start --kms vault", "castor provision --kms vault"; the token is minted
#   under the policy of docker/vault/beffroi-op.hcl):
#     BEFFROI_KMS_DSN="hashicorp-vault-transit://<token>@vault:8200?scheme=http"   BEFFROI_KMS_KEY_ID="beffroi-{tenant}"
#   AWS KMS, on the desk with Floci ("castor start --kms aws", "castor provision --kms aws"; the alias
#   is created by docker/floci/init.sh) or on an account ("aws-kms://default?region=<region>" and the
#   credentials of the provider chain, the same alias under the key policy of the CISO page):
#     BEFFROI_KMS_DSN="aws-kms://test:test@floci:4566?region=eu-west-3&scheme=http"   BEFFROI_KMS_KEY_ID="alias/beffroi-{tenant}"
BEFFROI_KMS_DSN=
# The master key a rewrap moves the data keys to, which is what two clients configured at once means
# (config/packages/key_management.yaml). Empty for a deployment that moves nothing: the client is declared
# and never built. It carries a key under the same id as BEFFROI_KMS_KEY_ID, a rewrap naming one master key
# for the deployment, so "castor provision --kms sodium" and "castor provision --kms vault" write a sodium key
# under that id and the other backends write none.
BEFFROI_KMS_DSN_SECOND=
BEFFROI_KMS_KEY_ID=
# The plane this process serves: provider (interaction and protocol), interaction, protocol or administration
# (docs/11-architecture/application.md §5.2).
BEFFROI_PLANE=provider
# How many requests a FrankenPHP worker thread serves before it starts again, read by symfony/runtime, which
# restarts it every 500 when nothing names a number: 0 never restarts it. A thread opens its keys when it starts,
# and one started again while the KMS does not answer could not open them.
FRANKENPHP_LOOP_MAX=0
# Where the four lanes of the provider go (architecture §5.6, issue #919): one DSN for the four, "{lane}" in it
# being where the name of each lane goes, so that each is a queue of its own; a DSN that names no "{lane}" is
# refused when the transport of a lane is built. The database here, a queue of the table "messenger_messages"
# per lane, which a migration creates as the owner of the tables, no transport creating it. The application carries
# no transport of a broker, nor the image the extension of one (issue #927): the database is where the lanes of a
# deployment of it go. What fails stays in the database whatever this names.
BEFFROI_MESSENGER_DSN='doctrine://default?queue_name={lane}'
# The windows of a rotation (docs/11-architecture.md §3.3, §9): how long a relying party may cache the JWK Set
# (the staging delay of a new key derives from it), and the lifetimes of the two JWS the tenant issues (the
# retirement window of the key that signed them is the longest one). The choices of the architecture; "castor
# demo --rotate" shortens them in .env.local for the time of its run, so that a whole rotation fits in minutes.
BEFFROI_JWKS_MAX_AGE=300
BEFFROI_ACCESS_TOKEN_TTL=600
BEFFROI_ID_TOKEN_TTL=600
# How long a new key is published before it signs, in seconds: empty, the max-age above plus the 60 s refetch
# cooldown of oidc_login, so that the two follow each other. Then how long a key signs before a successor is
# staged: ninety days, inside the one to three years NIST SP 800-57 Part 1 Rev. 5 §5.3.6 gives a private
# signature key, and longer than the window a retiring key holds the JWK Set open for.
BEFFROI_KEY_STAGING_DELAY=
BEFFROI_KEY_AGE=7776000
# The other lifetimes, in seconds (docs/11-architecture.md §9): the authorization code, at most 600 (RFC 6749
# §4.1.2); the sliding and the absolute lifetime of a refresh token, the first no longer than the second; the
# request_uri of a pushed request, at most 600 (RFC 9126 §2.2); the device code, at most 1800 (RFC 8628 §3.2);
# the backchannel request, at most 3600 (CIBA Core §7.1). Every lifetime is a second at least, and a number
# out of its bounds is refused when the service it reaches is built, rather than served.
BEFFROI_AUTHORIZATION_CODE_TTL=60
BEFFROI_REFRESH_TOKEN_TTL=2592000
BEFFROI_REFRESH_TOKEN_ABSOLUTE_TTL=7776000
BEFFROI_REQUEST_URI_TTL=60
BEFFROI_DEVICE_CODE_TTL=600
BEFFROI_BACKCHANNEL_AUTHENTICATION_TTL=300
# The seconds a client waits between two polls of either flow that polls, five each, at most 30 (RFC 8628 §3.5, CIBA
# Core §11), and the longest a client of the backchannel flow may ask for with "requested_expiry", at most the hour
# a backchannel request lives (CIBA Core §7.1).
BEFFROI_DEVICE_CODE_INTERVAL=5
BEFFROI_BACKCHANNEL_AUTHENTICATION_INTERVAL=5
BEFFROI_BACKCHANNEL_AUTHENTICATION_MAX_REQUESTED_EXPIRY=1800
# Whether a DPoP proof carries a nonce this provider issued (RFC 9449 §8), "true" or "false": the "iat" of a
# proof is what its client says, a nonce is what the provider knows.
BEFFROI_DPOP_NONCE_REQUIRED=false
# How long a DPoP proof stands from its "iat", at least a second, what is allowed of the clock of its client both ways,
# none at least, and how long a nonce this provider issues is accepted, at least a second (RFC 9449 §11.1, §8).
BEFFROI_DPOP_PROOF_MAX_AGE=60
BEFFROI_DPOP_LEEWAY=30
BEFFROI_DPOP_NONCE_TTL=300
# What a "login_hint" names, on the login page (OIDC Core §3.1.2.1) and in a backchannel request (CIBA Core §7.1):
# "sub", the subject this provider issued to that client, "username", the name the user signs in with, or "none". The
# subject says who somebody is to this provider and to this client, and nowhere else (CIBA Core §15).
BEFFROI_INTERACTION_LOGIN_HINT=sub
BEFFROI_BACKCHANNEL_AUTHENTICATION_LOGIN_HINT=sub
# The languages the pages and the messages are served in, as '["fr","en"]', among those the application has a
# catalogue for (framework.enabled_locales), DEFAULT_LOCALE among them; empty, every one. The discovery document
# announces them in "ui_locales_supported".
BEFFROI_LOCALES='[]'
# How long one assertion a client signs to authenticate may stand ahead of the request, at least a second, and what is
# allowed of its clock, none at least (RFC 7523 §3); the issuers the tenant trusts are held to the same two.
BEFFROI_CLIENT_ASSERTION_MAX_LIFETIME=300
BEFFROI_CLIENT_ASSERTION_LEEWAY=30
# What one read of a "jwks_uri" of a client or of a trusted issuer may cost: the seconds it is given, a tenth of a
# second at least, and the bytes it may answer, one at least; how long the keys read back are kept, a second at least;
# and how often a read may come after one that failed, or after a "kid" the kept set does not hold, none at least.
BEFFROI_JWKS_URI_TIMEOUT=3
BEFFROI_JWKS_URI_MAX_SIZE=65536
BEFFROI_JWKS_URI_TTL=86400
BEFFROI_JWKS_URI_REFETCH_COOLDOWN=300
# The networks of the deployment that a request whose URL a client, a registrant or a person chose may reach (a
# "jwks_uri", a "sector_identifier_uri", a "request_uri", a back-channel logout URI, a CIBA notification endpoint, the
# endpoint of a push subscription), as a JSON list of IP addresses or networks in CIDR notation. Every other private,
# loopback, link-local or reserved address is refused (decision 0006); empty, none is reached. A deployment whose
# clients answer on its own networks names those, and no wider: '["10.20.0.0/16"]'.
BEFFROI_OUTBOUND_REACHABLE_PRIVATE_NETWORKS='[]'
# How long a request object may stand from its "nbf", at least a second, and what is allowed of the clock of its
# client, none at least (RFC 9101 §4); what one read of a "request_uri" a client hosts may cost, a tenth of a second
# and one byte at least.
BEFFROI_REQUEST_OBJECT_MAX_LIFETIME=3600
BEFFROI_REQUEST_OBJECT_LEEWAY=30
BEFFROI_REQUEST_OBJECT_TIMEOUT=3
BEFFROI_REQUEST_OBJECT_MAX_SIZE=65536
# What authorises a client that registers itself (RFC 7591, decision 0009): "initial_access_token", a
# credential "beffroi:client:token:issue" issues, "software_statement", a statement of an authority the
# tenant pins (RFC 7591 §2.3), or "open", whoever asks, which only a tenant with no real user writes. Empty
# here, and an empty mode is no registration endpoint at all: "composer dump-env prod" compiles this file into
# the image, which declares no client either, so a deployment that serves clients names its mode. "castor
# provision" writes "open", what the Dynamic OP plan needs, into .env.local for the development stack, and
# "castor demo --register" writes "initial_access_token" there for the time of its run. Then what a client
# that names no scope is registered with (RFC 7591 §2), space-delimited: empty, "openid" alone.
BEFFROI_REGISTRATION_MODE=
BEFFROI_REGISTRATION_DEFAULT_SCOPE=
# How long a client that registered itself is kept (decision 0009): unused for ninety days once it was used, seven
# days at all when it never was, a second at least each. Then what one read of its "sector_identifier_uri" may cost,
# a tenth of a second and one byte at least (OIDC Registration §5), and how long a software statement may stand ahead
# of the request, at least a second, with what is allowed of the clock of its authority, none at least (RFC 7591
# §2.3).
BEFFROI_REGISTRATION_KEEP_A_CLIENT_UNUSED_FOR=7776000
BEFFROI_REGISTRATION_KEEP_A_CLIENT_NEVER_USED_FOR=604800
BEFFROI_REGISTRATION_SECTOR_IDENTIFIER_TIMEOUT=3
BEFFROI_REGISTRATION_SECTOR_IDENTIFIER_MAX_SIZE=65536
BEFFROI_REGISTRATION_STATEMENT_MAX_LIFETIME=300
BEFFROI_REGISTRATION_STATEMENT_LEEWAY=30
# What the tenant calls itself and shows of itself on every page (issue #449): its name, the host of the issuer
# when empty; its logo, an absolute HTTPS URL, the placeholder mark the image serves at the issuer
# (/tenant-logo.svg) when empty, whose origin every page that shows it names in its policy, a host of another
# origin answering "Cross-Origin-Resource-Policy: cross-origin" for the pages under "require-corp", the account
# among them, to load it (config/packages/nelmio_security.yaml); and the two colours its buttons and links are
# drawn in and written in, three or six hexadecimal digits behind a hash, both or neither, the ultramarine and
# the white of the default look of the stylesheet when empty (assets/styles/app.css).
BEFFROI_TENANT_NAME=
BEFFROI_TENANT_LOGO_URI=
BEFFROI_TENANT_PRIMARY_COLOR=
BEFFROI_TENANT_PRIMARY_CONTENT_COLOR=
# The identifier of the administration API of the tenant (decision 0038), the resource its tokens are addressed to
# (RFC 8707 §2), as https://admin.example.com: the provider addresses a token to it only for an administrator of the
# tenant (BEFFROI_TENANT_ADMINISTRATORS below) signed in at the authorization endpoint with a phishing-resistant proof,
# by a token bound to a key of the client, and never announces it. Empty, which reserves nothing.
BEFFROI_TENANT_ADMINISTRATION_RESOURCE=
# How long an act of the journal and a change of a claim are kept, in days (issues #454 and #482): six months,
# the duration the deliberation 2021-122 of the CNIL holds for a log of connections. A deployment under
# another obligation names its own.
BEFFROI_JOURNAL_RETENTION=180
BEFFROI_HISTORY_RETENTION=180
# The two load budgets of decision 0014: the requests one client address may send, and one authenticated
# client may ask, in a window of so many seconds. A number too low on /token or on /jwks is an outage a
# deployment inflicts on itself, so they are measured on what its own clients send.
BEFFROI_LOAD_ORIGIN_LIMIT=2400
BEFFROI_LOAD_ORIGIN_INTERVAL=60
BEFFROI_LOAD_CLIENT_LIMIT=1200
BEFFROI_LOAD_CLIENT_INTERVAL=60
# The budgets of the confirmations of an address (decision 0014): how many go out for one person, and how many to one
# address whatever the tenant, more than for a person, in a window of so many seconds. Past either, nothing is sent and
# the page says so.
BEFFROI_CONFIRMATION_SENDS_PERSON_LIMIT=5
BEFFROI_CONFIRMATION_SENDS_ADDRESS_LIMIT=10
BEFFROI_CONFIRMATION_SENDS_INTERVAL=86400
# The budget of the reads of one administrator (decision 0014): the persons the administration API delivers to one
# administrator of the tenant in a window of so many seconds, a page of members counting one per member. Past it, a
# read delivers nobody and is answered 429. The limit is a hundred at least, the largest page of members.
BEFFROI_ADMINISTRATOR_PERSONS_LIMIT=600
BEFFROI_ADMINISTRATOR_PERSONS_INTERVAL=3600
# The contact a push service is given in the token this provider signs for it (RFC 8292 §2.1), a "mailto:" or
# "https:" URI at which the operator of the deployment can be reached about what it sends. Naming one is what turns
# web push on, and empty turns it off: the tenant then hands out no key and reaches nobody by push. The one here is
# the development stack's: a deployment names its own. Then the seconds one push is given, a tenth at least.
BEFFROI_WEB_PUSH_SUBJECT=mailto:operator@op.localhost
BEFFROI_WEB_PUSH_TIMEOUT=3
# How a person is reached at the email address and the phone number marked verified, and at no other (decision
# 0048): each by its DSN, empty here, and empty turns it off, so that no mail and no text leave a deployment that names
# none. A mail goes through symfony/mailer, which carries SMTP ("smtp://user:password@host:587") and the scheme of
# every bridge the application installs, and is written from the sender beside it, an address alone or behind a name
# ("Acme <no-reply@acme.example>"); without one, no mail is written. A text goes through the texter of
# symfony/notifier, by the scheme of a bridge the application installs, the number or the name it is sent from among
# the options of that DSN; the application carries the bridge of Sweego (symfony/sweego-notifier, "sweego://"), and
# "null://null" drops what it is given. A DSN that no installed factory reads sends nothing, and the log says why each time.
BEFFROI_MAIL_DSN=
BEFFROI_MAIL_SENDER=
BEFFROI_SMS_DSN=
# How a logout token reaches a client that registered a "backchannel_logout_uri" (Back-Channel Logout 1.0 §2.5): the
# seconds one attempt is given, a tenth at least; then how many times a send that did not reach its client comes
# back, none at least, the wait before the first return, a second at least, what each wait is multiplied by to give
# the next, once at least, and the longest wait, a second at least: the schedule of the lane of the notifications,
# which carries a push and the word that a backchannel request was answered as well (CIBA Core §10.2), whose call is
# given the seconds after it, a tenth at least. A notice of a change to the credentials of an account is the one
# message of that lane on a schedule of its own, below.
BEFFROI_BACK_CHANNEL_LOGOUT_TIMEOUT=5
BEFFROI_BACK_CHANNEL_LOGOUT_RETRIES=6
BEFFROI_BACK_CHANNEL_LOGOUT_RETRY_DELAY=2
BEFFROI_BACK_CHANNEL_LOGOUT_RETRY_MULTIPLIER=3
BEFFROI_BACK_CHANNEL_LOGOUT_RETRY_MAX_DELAY=60
BEFFROI_CLIENT_NOTIFICATION_TIMEOUT=3
# How a notice of a change to the credentials of an account comes back to a channel that did not take it, a mail
# server or an SMS provider that is down (decision 0049): how many times, none at least, the wait before the first
# return, a second at least, what each wait is multiplied by to give the next, once at least, and the longest wait, a
# second at least. 31 attempts over 25 hours here; once they are spent, the notice not delivered is an act of the
# person, which their page of acts shows.
BEFFROI_NOTICE_RETRIES=30
BEFFROI_NOTICE_RETRY_DELAY=60
BEFFROI_NOTICE_RETRY_MULTIPLIER=2
BEFFROI_NOTICE_RETRY_MAX_DELAY=3600
# The licence key of the MaxMind account the GeoLite2 databases of addresses are downloaded under, which is
# what lets a provenance say from where and not only from which address (docs/11-architecture.md §3.5).
# Empty here: the databases are published by MaxMind under their own licence, so nothing is shipped and
# nothing is downloaded until a deployment names its key, which a free account gives. A deployment that
# leaves it empty serves every flow and says no place.
GEOIP_LICENSE_KEY=
# The list of compromised passwords a password posed here is compared against before it is written, which
# is the rule NIST SP 800-63B §3.1.1.2 puts above the length (docs/11-architecture.md §3.4). Empty here:
# calling a service this provider does not own is a deployment's decision and not a default it discovers,
# and the development stack provisions and signs in with no network. A deployment that wants it writes
# "https://api.pwnedpasswords.com/range/", where the first five hexadecimal characters of the SHA-1 of a
# password leave, the comparison of the rest is local, and no API key is needed. A deployment that leaves
# it empty poses passwords and signs people in on the rules of the core alone.
BEFFROI_BREACHED_PASSWORDS_ENDPOINT=
# The seconds one lookup in that list is given, a tenth at least: a person is waiting on a form.
BEFFROI_BREACHED_PASSWORDS_TIMEOUT=2
# The roles of the tenant in SAML (beffroi/saml): "true" or "false" each. The identity provider serves its metadata at
# /saml/metadata and the service providers below; the service provider receives the assertions of the upstream
# identity providers below, named by the URL of its metadata unless its entity ID is named, absolute and not the one
# of the identity provider (spec/saml.md S-38). A role turned off serves nothing, and with both off the tenant draws
# no SAML key. Then the figures of the family of the SAML keys, the key of both roles (S-12): published seven days
# before it signs, none at least, working a year, a second at least, and the metadata kept a day by a service
# provider, a second at least and shorter than the seven days; and whether the metadata ask a service provider to
# sign its requests.
BEFFROI_SAML_IDENTITY_PROVIDER=true
BEFFROI_SAML_SERVICE_PROVIDER=false
BEFFROI_SAML_SERVICE_PROVIDER_ENTITY_ID=
BEFFROI_SAML_KEY_STAGING_DELAY=604800
BEFFROI_SAML_KEY_AGE=31536000
BEFFROI_SAML_METADATA_CACHE_DURATION=86400
BEFFROI_SAML_WANT_AUTHN_REQUESTS_SIGNED=true
# SCIM 2.0 (beffroi/scim), the endpoints under /scim/v2 the directories of the tenant push its persons and groups to:
# "true" or "false". Off, nothing of the module is built and every route of it answers 404.
BEFFROI_SCIM=false
# Nine lists of the configuration, each a JSON document of the shape the list has in the reference of the bundle
# (decision 0030), held to the rules a written list is held to when the service it reaches is built; "{}" or
# "[]" for none, an empty variable being no JSON document and refused there. First what the people of the tenant
# may change of themselves (issue #452): the fourteen claims the bundle lets a person change, the tenant of this
# image creating its people by hand. Then the "acr" vocabulary of the tenant, class name to predicate in order
# (decision 0010): none, which is the default policy of the core. Then the scopes of the APIs the tenant protects
# (issue #920), as '["invoices.read","invoices.pay"]': the tenant hands out tokens for them beside "openid", the
# scopes of its claims and "offline_access", announces them, and a client that registers itself may register
# them; none, an image protecting no API until its deployment names one. Then the groups whose members administer the
# tenant (decision 0038), by their names in the tenant, as '["administrators"]', a local group the console fills or a
# group a directory holds: none, nobody administering a tenant whose deployment did not say who does.
BEFFROI_TENANT_SELF_SERVED_CLAIMS='["name","given_name","family_name","middle_name","nickname","preferred_username","birthdate","gender","locale","zoneinfo","profile","picture","website","phone_number"]'
BEFFROI_TENANT_AUTHENTICATION_CLASSES='{}'
BEFFROI_TENANT_SCOPES='[]'
BEFFROI_TENANT_ADMINISTRATORS='[]'
# The issuers whose assertions the tenant accepts as an authorization (RFC 7523 §2.1), and the authorities whose
# software statements it accepts (RFC 7591 §2.3), keyed by the "iss" they sign with: none.
BEFFROI_TRUSTED_ISSUERS='{}'
BEFFROI_REGISTRATION_STATEMENT_ISSUERS='{}'
# The SAML service providers the identity provider of the tenant serves, and the upstream identity providers its
# service provider receives assertions of, keyed by entity ID (spec/saml.md S-5, S-42): none.
BEFFROI_SAML_SERVICE_PROVIDERS='{}'
BEFFROI_SAML_IDENTITY_PROVIDERS='{}'
# The secrets that bind the data keys (decision 0018), a JSON list, the one that binds a new row first. Not set
# here, which binds them with APP_SECRET alone: a rotation of APP_SECRET sets it to the new secret and the old one,
# runs "beffroi:data-keys:rewrap" for every tenant, then drops the old one.
# BEFFROI_DATA_KEY_SECRETS='["<the new secret>","<the old secret>"]'
# What the enrolment of a passkey asks of its authenticator (WebAuthn Level 3 §5.4.7, decision 0046): "none", the
# model of a passkey being the one its authenticator declares; "direct", the model verified when the FIDO metadata
# know it ("beffroi:webauthn:mds-refresh") and declared otherwise, a passkey never being refused for want of an
# attestation; or "enterprise", only an attestation that chains up to a root the tenant pins enrolling, an enterprise
# attestation being permitted per relying party identifier, which is the host of the issuer. Then three JSON
# documents: the PEM roots of the enterprise attestations it admits, under which the serial number of the
# authenticator is required (WebAuthn Level 3 §8.2.2); the PEM authorities of the tenant itself, the ones that sign
# the identities of its own devices, under which it is not; and, under "direct" and "enterprise", the models whose
# last status report is a security notification it still enrols, as '{"<AAGUID>":"2027-03-31"}', each to the last
# day it does. None asked, none pinned, none admitted: the image enrols passkeys as it always did.
BEFFROI_TENANT_PASSKEY_ATTESTATION=none
BEFFROI_TENANT_PASSKEY_ATTESTATION_ROOTS='[]'
BEFFROI_TENANT_PASSKEY_ATTESTATION_OWN_ROOTS='[]'
BEFFROI_TENANT_PASSKEY_COMPROMISED_MODELS='{}'
###< beffroi ###

# The variables of the development stack and of the suite of this application are not in this file, which is what
# "composer dump-env prod" compiles into the image (issue #922): the configuration of development documents the ones
# it reads and gives them their default (config/packages/dev/, config/packages/web_profiler.yaml), "castor provision"
# writes the secrets and the keys of its clients into .env.local, and .env.test holds the fixtures of the suite.
