<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- One act of the provider, written down (issue #454). The identifier is a UUIDv7, which sorts chronologically, so the acts of a person are read in the order they happened by their primary key and never by a date. The provenance is sealed under the data key of the tenant, being what the request carried of a person (decisions 0011 and 0018); the subject beside it is in the clear, naming a person without saying anything about them. -->
    <entity name="Beffroi\Core\Domain\Journal\JournalEntry" table="beffroi_journal">
        <indexes>
            <!-- What the page of a person reads: the acts of their account, named one by one, the newest first (ActsOfAnAccount). -->
            <index name="beffroi_journal_person" columns="tenant_id,subject,act,id"/>
            <!-- What the statistics read, the acts of a tenant counted since a moment. The retention follows the order of the chain instead (decision 0060). -->
            <index name="beffroi_journal_kept_until" columns="tenant_id,occurred_at"/>
        </indexes>
        <id name="id" type="uuid" column="id"/>
        <many-to-one field="tenant" target-entity="Beffroi\Core\Domain\Tenant\Tenant">
            <join-column name="tenant_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
        <field name="act" type="string" column="act" length="64"/>
        <field name="occurredAt" type="datetime_immutable" column="occurred_at"/>
        <field name="context" type="beffroi_encrypted_journal_request_context" column="context"/>
        <field name="subject" type="beffroi_subject" column="subject" length="255" nullable="true"/>
        <field name="client" type="string" column="client" length="255" nullable="true"/>
        <!-- Who did the act, by their kind and what names them among their kind: the person, an administrator by the subject of their account, a client by its identifier, a directory or an upstream provider by its name, an unauthenticated caller, or the host (decision 0066). In the clear, as the subject is. An act written before acts named their author holds its administrator by their bare subject, or NULL for the person or the host (JournalAuthorType). -->
        <field name="author" type="beffroi_journal_author" column="author" nullable="true"/>
        <!-- Why a refusal refused and the method it refused, words this provider gives them (decision 0062). In the clear: they say nothing of a person. -->
        <field name="reason" type="string" column="reason" length="64" nullable="true"/>
        <field name="method" type="string" column="method" length="64" nullable="true"/>
    </entity>
</doctrine-mapping>
