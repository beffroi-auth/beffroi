<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
      The newest metadata document accepted for a service provider of a tenant (beffroi/saml, spec/saml.md
      S-6 and S-8), the rest of the row being what every peer keeps (Metadata.AcceptedMetadata.orm.xml).

      The document is sealed under the data key of its tenant, in the `saml_service_provider` family
      (decisions 0011 and 0018): an `md:ContactPerson` names people, their electronic addresses and their
      telephone numbers. Nothing looks a service provider up by a member of its document, so nothing is
      lost with the query the ciphertext takes away. The entity ID names a service and is what a row is
      found by, in the clear.
    -->
    <entity name="Beffroi\Saml\Domain\ServiceProvider\AcceptedServiceProviderMetadata" table="beffroi_saml_service_provider">
        <unique-constraints>
            <unique-constraint name="beffroi_saml_service_provider_entity" columns="tenant_id,entity_id"/>
        </unique-constraints>
        <field name="document" type="beffroi_encrypted_saml_service_provider_text" column="document"/>
    </entity>
</doctrine-mapping>
