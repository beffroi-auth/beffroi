<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!--
      The newest metadata document accepted for an upstream identity provider of a tenant (beffroi/saml,
      spec/saml.md S-6, S-8 and S-42), the rest of the row being what every peer keeps
      (Metadata.AcceptedMetadata.orm.xml). One row per identity provider, found by its entity ID, unique under
      its tenant; its declaration is in the configuration of the deployment and never here.

      The document is sealed under the data key of its tenant, in the `saml_upstream_identity_provider` family
      (decisions 0011 and 0018): an `md:ContactPerson` names people, as a service provider's does. The entity
      ID names a service and is what a row is found by, in the clear.
    -->
    <entity name="Beffroi\Saml\Domain\Upstream\AcceptedUpstreamMetadata" table="beffroi_saml_upstream_identity_provider">
        <unique-constraints>
            <unique-constraint name="beffroi_saml_upstream_identity_provider_entity" columns="tenant_id,entity_id"/>
        </unique-constraints>
        <field name="document" type="beffroi_encrypted_saml_upstream_identity_provider_text" column="document"/>
    </entity>
</doctrine-mapping>
